[Unit]
Description=Two-finger-tap-to-right-click on touchscreen
After=multi-user.target

[Service]
Type=simple
Environment=USER_XDG_RUNTIME_DIR=/run/user/__USER_UID__
Environment=TARGET_UID=__USER_UID__
# Root-owned path and -I: see ROOT_LIBDIR in lib.sh.
ExecStart=/usr/bin/python3 -I __ROOT_LIBDIR__/two-finger-right-click.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
