[Unit]
Description=Hide OSK/trackpad and enable touch-dismiss for the screensaver
# System-scoped, because this reads the touchscreen directly and /dev/input/*
# is root:input -- logind hands the compositor its devices over D-Bus rather
# than through file permissions, so as the user this process sees no input
# devices at all. Same reason trackpad-injector and two-finger-rightclick are
# system units.
#
# That rules out the graphical-session.target ordering a user unit would use:
# the system manager has no such target and never sees HYPRLAND_INSTANCE_SIGNATURE,
# so a ConditionEnvironment on it would keep the unit from ever starting. The
# script instead tolerates the compositor not being up yet -- it locates the
# Hyprland instance on disk each time it needs it, and simply does nothing
# until one exists.
After=multi-user.target

[Service]
Type=simple
Environment=USER_XDG_RUNTIME_DIR=/run/user/__USER_UID__
Environment=TARGET_UID=__USER_UID__
# Root-owned path and -I: see ROOT_LIBDIR in lib.sh.
ExecStart=/usr/bin/python3 -I __ROOT_LIBDIR__/screensaver-touch-helper.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
